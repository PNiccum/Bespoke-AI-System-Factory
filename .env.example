# Copy to .env in the project root and fill in. .env is git-ignored; never commit a key or paste one in a chat.
# ARC (Virginia Tech's LLM gateway, https://llm-api.arc.vt.edu/api). Needed for every run: the free default models.
ARC_API_KEY=
# Claude API. Used only for the paid reviewer step (claude-sonnet-5-5), and only after a person approves.
ANTHROPIC_API_KEY=
# OpenAI API. Used only for the paid coder step (gpt-6.1-sol), and only after a person approves.
OPENAI_API_KEY=

# Research sources for the knowledge loop (optional: all three work without a key, at lower rate limits)
OPENALEX_API_KEY=
NCBI_API_KEY=
# An email address OpenAlex can reach you at, for its polite pool
ASPIRE_CONTACT_EMAIL=
