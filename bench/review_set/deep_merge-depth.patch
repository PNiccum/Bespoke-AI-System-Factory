--- a/conf/merge.py
+++ b/conf/merge.py
@@ -1,6 +1,10 @@
-def merge(base, override):
+def merge(base, override, depth=0):
     """Return a new config: override's values win, and nested sections are merged key by key, not replaced.
     Neither argument is changed."""
     out = dict(base)
-    out.update(override)
+    for key, value in override.items():
+        if depth < 2 and isinstance(value, dict) and isinstance(out.get(key), dict):
+            out[key] = merge(out[key], value, depth + 1)
