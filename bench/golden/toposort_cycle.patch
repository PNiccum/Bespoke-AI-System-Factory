+
+def _find_cycle(deps, stuck):
+    """Every stuck task needs another stuck task, so walking needs from any of them must loop."""
+    path, seen = [], {}
+    n = min(stuck)
+    while n not in seen:
+        seen[n] = len(path)
+        path.append(n)
+        n = min(d for d in deps.get(n, []) if d in stuck)
+    return path[seen[n]:] + [n]
